# Copy to .env.local and fill in. Never commit real values.

# MongoDB connection string (Atlas or local), including the database name.
MONGODB_URI="mongodb://localhost:27017/foodmortem"

# Secret used to sign session tokens. Server-only: never prefix with NEXT_PUBLIC_.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Category names (comma-separated) featured as carousels on the home page.
FEATURED_CATEGORIES="kacchi,burger,pizza"
